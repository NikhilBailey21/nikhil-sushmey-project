# Flask Application Environment Variables
# Copy this file to .env and fill in your actual values
# Flask will automatically load .env when FLASK_ENV=development (if python-dotenv is installed)

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_APP=flaskr
FLASK_ENV=development

# Flask Secret Key
# Used for session management and CSRF protection
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================================
# Google OAuth Configuration
# ============================================================================
# To get a Google OAuth Client ID:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID
# 3. Set the application type to "Web application"
# 4. Add authorized JavaScript origins: http://localhost:5000
# 5. Add authorized redirect URIs: http://localhost:5000/auth/google-callback
# 6. Copy the Client ID and paste it below
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ============================================================================
# Database Configuration
# ============================================================================

# Cloud SQL connection (for production-like testing)
CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=flaskr

