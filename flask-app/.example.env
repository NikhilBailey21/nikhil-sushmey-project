# Flask Application Environment Variables
# Copy this file to .env and fill in your actual values
# Flask will automatically load .env when FLASK_ENV=development (if python-dotenv is installed)
#
# ============================================================================
# GITHUB ACTIONS SECRETS REFERENCE
# ============================================================================
# The following secrets must be configured in GitHub Actions for deployments:
#
# REQUIRED SECRETS (all workflows):
#   - GCP_PROJECT_ID: Your Google Cloud Project ID
#   - GCP_REGION: Your Google Cloud region (e.g., us-central1)
#   - GCP_SA_KEY: Service account JSON key for GCP authentication
#
# OPTIONAL SECRETS (RabbitMQ deployment):
#   - GCP_ZONE: Compute Engine zone (defaults to us-central1-a if not set)
#
# REQUIRED SECRETS (Flask app deployment):
#   - CLOUD_SQL_CONNECTION_NAME: Cloud SQL connection string (project:region:instance)
#   - DB_USER: Database username
#   - DB_PASS: Database password
#   - DB_NAME: Database name
#   - SECRET_KEY: Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
#   - GOOGLE_CLIENT_ID: Google OAuth Client ID
#
# OPTIONAL SECRETS (RabbitMQ - set after first RabbitMQ deployment):
#   - RABBITMQ_HOST: Static IP of RabbitMQ VM (get from deployment output)
#   - RABBITMQ_PORT: RabbitMQ port (defaults to 5672 if not set)
#   - RABBITMQ_USER: RabbitMQ username (defaults to admin if not set)
#   - RABBITMQ_PASS: RabbitMQ password (defaults to admin if not set)
#   - RABBITMQ_VHOST: RabbitMQ virtual host (defaults to / if not set)
#
# ============================================================================

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_APP=flaskr
FLASK_ENV=development

# Flask Secret Key
# Used for session management and CSRF protection
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================================
# Google OAuth Configuration
# ============================================================================
# To get a Google OAuth Client ID:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID
# 3. Set the application type to "Web application"
# 4. Add authorized JavaScript origins: http://localhost:5000
# 5. Add authorized redirect URIs: http://localhost:5000/auth/google-callback
# 6. Copy the Client ID and paste it below
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ============================================================================
# Database Configuration
# ============================================================================

# Cloud SQL connection (for production-like testing)
CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=flaskr

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
# RabbitMQ connection settings for work queue
# For local development, use: localhost
# For production, use the Compute Engine VM external IP
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_VHOST=/

